# ── Multilingual Call Audit Engine — Environment Variables ────────────────────
# Copy this file to .env and fill in your keys.

# ── LLM APIs (required for audit + coaching) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...        # Claude Sonnet — audit + coaching (primary)
OPENAI_API_KEY=sk-...               # GPT-4o — entity extraction + fallback
GEMINI_API_KEY=AIza...              # Gemini 2.0 Flash — summarization (cheapest)

# ── Speech-to-Text ─────────────────────────────────────────────────────────────
SARVAM_API_KEY=...                  # Sarvam Saarika v2 — Indic languages
                                    # Get at: https://www.sarvam.ai

# ── ASR Configuration ─────────────────────────────────────────────────────────
STT_PROVIDER=auto                   # auto | sarvam | faster-whisper | whisper
WHISPER_MODEL_SIZE=large-v3         # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                  # cpu | cuda

# ── Speaker Diarization ────────────────────────────────────────────────────────
DIARIZATION_PROVIDER=auto           # auto | pyannote | stereo | mock
HF_TOKEN=hf_...                     # HuggingFace token for Pyannote 3.1
                                    # Accept model at: https://hf.co/pyannote/speaker-diarization-3.1

# ── Storage (temporary/scratch uploads — NOT persistent, see STORAGE_BACKEND
# below for what actually needs to survive a restart) ─────────────────────────
UPLOAD_DIR=tmp_uploads
MAX_UPLOAD_SIZE_MB=1000

# ── Database backend — "sqlite" (default) or "postgres" ──────────────────────
# See CLOUD_MIGRATION_PLAN.md. Only switch to postgres after
# scripts/migrate_sqlite_to_postgres.py has succeeded.
DATABASE_URL=
DB_BACKEND=sqlite

# ── Object storage backend — "local" (default) or "r2" ────────────────────────
# Independent of DB_BACKEND — either can be sqlite/postgres and local/r2 in
# any combination. Only used by storage/r2.py when STORAGE_BACKEND=r2.
# Test connectivity with: python scripts/test_r2.py
STORAGE_BACKEND=local
R2_ENDPOINT_URL=
R2_BUCKET_NAME=kalvium-audit-storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ── Existing Kalvium pipeline (v1 — unchanged) ─────────────────────────────────
# OPENAI_API_KEY already covers this
# SARVAM_API_KEY already covers this
